{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-3",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "198aeb75-da16-4e0d-823a-a24c7360556a","database_name": "web-app-3" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b6271c36955e4dbcbec8b66fa8ca62d4" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
